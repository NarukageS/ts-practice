# --- Dependency directories (依存パッケージ) ---
node_modules/
jspm_packages/
web_modules/

# --- Build outputs (コンパイル・ビルド生成物) ---
dist/
out/
build/
*.tsbuildinfo

# --- Logs (ログファイル) ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Environment variables (環境変数・機密情報) ---
# ※ .env 本番ファイルは絶対コミットしないよう除外します
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env.js

# --- IDEs and Editors (エディタ・開発ツール設定) ---
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# VS Codeの設定（プロジェクト共有したい設定以外を除外）
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# --- OS temporary files (OS固有の一時ファイル) ---
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini